# YaYa-SaaS-Plus 环境变量配置示例
# 复制为 .env 或直接设置为系统环境变量 / 容器环境变量后启动应用。
# 本文件中的值仅为占位符，切勿把真实密钥提交到代码仓库。

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yaya-saas-plus
DB_USERNAME=root
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT 密钥(RS256, Base64 编码) ----------
# 生成方式: 运行 com.yaya.util.CryptoUtils#main() 或用 openssl 生成 RSA 密钥对后 Base64。
# 未配置时应用会生成临时密钥并打印警告, 重启后已签发 Token 全部失效, 生产环境务必配置。
YAYA_JWT_PUBLIC_KEY=
YAYA_JWT_PRIVATE_KEY=

# ---------- AI 模型(master 分支预留, yaya-rag 分支实际使用) ----------
DEEPSEEK_API_KEY=
